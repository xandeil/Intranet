# Copie este arquivo para server/.env e preencha. NUNCA commite o .env.

# API do Login Único (sem barra no final)
LOGIN_UNICO_API_URL=https://loginunico.jucepe.pe.gov.br/api
# Chave do sistema "intranet" (gerada uma única vez no cadastro do sistema)
LOGIN_UNICO_API_KEY=
# Para onde o usuário vai quando não está logado ou faz logout
LOGIN_UNICO_PORTAL_URL=https://loginunico.jucepe.pe.gov.br

# Segredo para assinar o JWT da sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Validade da sessão em segundos (padrão: 28800 = 8h)
SESSION_TTL=28800

# E-mails ou CPFs (só dígitos) com perfil admin, separados por vírgula
ADMIN_USERS=

# Origem pública da Intranet (protocolo + host + porta, sem barra no final).
# Usada para conferir o header Origin no logout.
PUBLIC_ORIGIN=http://localhost:5172

# Porta do BFF
PORT=3001

# Caminho para a CA do certificado do Login Único, se ele não for confiável
# (ex.: ao usar https://200.238.99.104:8090). Deixe vazio com o domínio oficial.
NODE_EXTRA_CA_CERTS=
