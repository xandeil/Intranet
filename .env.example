# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# ".env" não é versionado (veja .gitignore) — este arquivo é a documentação
# de quais variáveis existem e qual o formato esperado.

# API
VITE_API_URL=https://localhost:8090

# Rotas do Sistema (Config-Driven Routing)
# Veja src/config/routes.js — qualquer variável ausente aqui cai no fallback
# já definido no código, então o app nunca quebra por falta de uma dessas linhas.
#
# VITE_ROUTE_LOGIN e VITE_ROUTE_DASHBOARD são absolutos. Todas as demais
# VITE_ROUTE_* abaixo são relativas à raiz do Dashboard: se você mudar
# VITE_ROUTE_DASHBOARD para "/dashboard", elas passam a viver automaticamente
# em "/dashboard/perfil", "/dashboard/admin" etc. — não precisa reescrevê-las.
VITE_ROUTE_LOGIN=/login
VITE_ROUTE_DASHBOARD=/

VITE_ROUTE_PERFIL=/perfil
VITE_ROUTE_PERFIL_EDITAR=/perfil/editar
VITE_ROUTE_CONFIGURACOES=/configuracoes

VITE_ROUTE_DOCUMENTOS=/documentos
VITE_ROUTE_PUBLICACOES=/publicacoes
VITE_ROUTE_CONTATO=/contato

VITE_ROUTE_PRESIDENTE=/presidente
VITE_ROUTE_ANIVERSARIANTES=/aniversariantes
VITE_ROUTE_CRONOGRAMAS=/cronogramas
VITE_ROUTE_GALERIA=/galeria
VITE_ROUTE_COLABORADORES=/colaboradores

VITE_ROUTE_ALMOXARIFADO=/almoxarifado
VITE_ROUTE_EQUIPAMENTOS=/equipamentos
VITE_ROUTE_PLENARIA=/plenaria

VITE_ROUTE_SISTEMAS=/sistemas
VITE_ROUTE_SISTEMAS_LINKS=/sistemas/links
VITE_ROUTE_POWERBI=/powerbi
VITE_ROUTE_MONITORAMENTO=/monitoramento
VITE_ROUTE_CHAMADOS=/chamados

VITE_ROUTE_RELATORIOS=/relatorios
VITE_ROUTE_PONTO=/ponto
VITE_ROUTE_TIMESHEET=/timesheet

VITE_ROUTE_ADMIN=/admin
VITE_ROUTE_PUBLICAR=/administracao/publicar
